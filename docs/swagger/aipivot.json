          "properties": {
            "chunkCount": {
              "type": "integer"
            },
            "contentType": {
              "type": "string"
            },
            "createdAt": {
              "type": "integer"
            },
            "errorMsg": {
              "type": "string"
            },
            "fileSize": {
              "type": "integer"
            },
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "updatedAt": {
              "type": "integer"
            },
            "uuid": {
              "type": "string"
            }
          },
          "$ref": "#/definitions/ShowDocument"
        },
        "msg": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer"
        }
      }
