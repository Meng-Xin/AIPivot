  "definitions": {
    "CloseConversationRequest": {
      "type": "object"
    },
    "CommResponse": {
      "type": "object",
      "required": [
        "code",
        "msg",
        "timestamp"
      ],
      "properties": {
        "code": {
          "description": "业务状态码，0 表示成功",
          "type": "integer",
          "example": 0
        },
        "msg": {
          "description": "响应消息",
          "type": "string",
          "example": "OK"
        },
        "timestamp": {
          "description": "响应时间戳（Unix 毫秒）",
          "type": "integer",
          "example": 1715300000000
        }
      }
    },
    "ConversationDetailResponse": {
      "type": "object",
      "required": [
        "code",
        "msg",
        "timestamp",
        "data"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "data": {
          "type": "object",
          "required": [
            "id",
            "uuid",
            "knowledgeBaseId",
            "title",
            "status",
            "channel",
            "messageCount",
            "createdAt",
            "updatedAt"
          ],
          "properties": {
            "channel": {
              "type": "string"
            },
            "createdAt": {
              "type": "integer"
            },
            "id": {
              "type": "integer"
            },
            "knowledgeBaseId": {
              "type": "integer"
            },
            "messageCount": {
              "type": "integer"
            },
            "status": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "updatedAt": {
              "type": "integer"
            },
            "uuid": {
              "type": "string"
            }
          },
          "$ref": "#/definitions/ShowConversation"
        },
        "msg": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer"
        }
      }
    },
    "ConversationListData": {
      "type": "object",
      "required": [
        "total",
        "list"
      ],
      "properties": {
        "list": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ShowConversation"
          }
        },
        "total": {
          "type": "integer"
        }
      }
    },
    "ConversationListResponse": {
      "type": "object",
      "required": [
        "code",
        "msg",
        "timestamp",
        "data"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "data": {
          "type": "object",
          "required": [
            "total",
            "list"
          ],
          "properties": {
            "list": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ShowConversation"
              }
            },
            "total": {
              "type": "integer"
            }
          },
          "$ref": "#/definitions/ConversationListData"
        },
        "msg": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer"
        }
      }
    },
    "CreateConversationRequest": {
      "type": "object",
      "properties": {
        "knowledgeBaseId": {
          "description": "关联知识库 ID",
          "type": "integer"
        },
        "title": {
          "description": "会话标题",
          "type": "string"
        }
      }
    },
    "CreateKnowledgeBaseRequest": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "description": {
          "description": "知识库描述",
          "type": "string"
        },
        "model": {
          "description": "Embedding 模型",
          "type": "string",
          "default": "text-embedding-3-small",
          "example": "text-embedding-3-small"
        },
        "name": {
          "description": "知识库名称",
          "type": "string"
        }
      }
    },
    "DeleteDocumentRequest": {
      "type": "object"
    },
    "DeleteKnowledgeBaseRequest": {
      "type": "object"
    },
    "DependencyStatus": {
      "type": "object",
      "required": [
        "name",
        "ready"
      ],
      "properties": {
        "error": {
          "description": "错误信息，就绪时为空",
          "type": "string",
          "example": ""
        },
        "name": {
          "description": "依赖名称，如 mysql、redis",
          "type": "string",
          "example": "mysql"
        },
        "ready": {
          "description": "是否就绪",
          "type": "boolean",
          "example": true
        }
      }
    },
    "DocumentDetailResponse": {
      "type": "object",
